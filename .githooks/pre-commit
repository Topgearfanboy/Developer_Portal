#!/bin/sh
# Run tests before every commit. Abort the commit if any test fails.

echo "Running tests before commit..."

# Run security scan - blocks commit on HIGH or CRITICAL vulnerabilities
if command -v osv-scanner >/dev/null 2>&1; then
  echo "🔒 Running security scan..."

  # Get JSON output and check for high/critical severity (>= 7.0)
  HIGH_VULNS=$(osv-scanner scan --lockfile=package-lock.json --format=json 2>/dev/null | \
    grep -o '"severity":\s*{[^}]*"score":\s*"[7-9]\.' | wc -l)

  if [ "$HIGH_VULNS" -gt 0 ]; then
    echo ""
    echo "❌ Found $HIGH_VULNS HIGH/CRITICAL vulnerability(s) (severity >= 7.0). Commit aborted."
    echo "Run 'npm run security:scan' for details. Fix vulnerabilities before committing."
    exit 1
  fi

  echo "✅ No high/critical vulnerabilities found."
  echo ""
fi

# Run full test suite (unit + E2E)
echo "🧪 Running full test suite (unit + E2E)..."
npm run test:unit -- --no-coverage && npm run test:e2e

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Tests failed. Commit aborted. Fix the failing tests and try again."
  exit 1
fi

echo "✅ All tests passed (unit + E2E). Proceeding with commit."
exit 0
