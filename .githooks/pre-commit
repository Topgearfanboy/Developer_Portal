#!/bin/sh
# Run tests before every commit. Abort the commit if any test fails.

echo "Running tests before commit..."

# Optional: Run security scan (warning only, doesn't block commit)
if command -v osv-scanner >/dev/null 2>&1; then
  echo "🔒 Running security scan..."
  osv-scanner scan --lockfile=package-lock.json 2>/dev/null || true
  echo ""
fi

# Run full test suite (unit + E2E)
echo "🧪 Running full test suite (unit + E2E)..."
npm run test:unit -- --no-coverage && npm run test:e2e

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Tests failed. Commit aborted. Fix the failing tests and try again."
  exit 1
fi

echo "✅ All tests passed (unit + E2E). Proceeding with commit."
exit 0
